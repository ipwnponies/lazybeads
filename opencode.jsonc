{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "reviewer_impl": {
      "permission": {
        "bash": {
          "go test ./internal/app": "allow"
        }
      }
    },
    "qa": {
      "permission": {
        // Allow QA to create scripts in /tmp
        "edit": {
          "/tmp/": "allow"
        },
        "read": {
          "/tmp/": "allow"
        },
      }
    }
  },
  "permission": {
    "bash": {
      "gofmt *": "allow",
      "go test *": "allow",
    }
  },
}
